# Copy to .env.local for local development. Never commit real values.
# Only variables used by implemented features are listed here (README
# "Environment configuration") - see packages/contracts/src/env.ts for the
# validated schema these are checked against at startup.

NODE_ENV=development

# Postgres connection string.
DATABASE_URL=postgres://postgres:onevyrt@127.0.0.1:5432/onevyrt_dev

# 32-byte hex secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# Public base URL of the web app.
APP_URL=http://localhost:3000

# Optional - enables packages/ai's real Anthropic provider adapter
# (ADR-0010). Leave unset to use the deterministic adapter instead.
ANTHROPIC_API_KEY=

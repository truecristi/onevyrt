node_modules/
.next/
.turbo/
*.log
.env*
!.env.example
.DS_Store

# Runtime data: real user accounts, password hashes, workspaces, projects,
# audit logs, and file-based backups. Never belongs in version control.
.gearbox/

# Playwright e2e output (apps/web/e2e/, run via npm run test:e2e)
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/

# TypeScript incremental build cache (regenerated by `tsc --noEmit`)
*.tsbuildinfo

# Build output (regenerated by tsc / next build)
packages/*/dist/

# Local scratch / design working files (mockups, seeded canvases) — never app code
scratchpad/

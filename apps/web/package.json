{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:analyze": "ANALYZE=true next build",
    "bundle:check": "node scripts/bundle-check.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.local -- tsx --test --test-concurrency=1 $(find test -name '*.test.ts' | sort)",
    "test:unit": "node scripts/test-unit.mjs",
    "test:unit:watch": "node --watch scripts/test-unit.mjs",
    "test:integration": "dotenv -e .env.local -- tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "test:edge-cases": "dotenv -e .env.local -- tsx --test --test-concurrency=1 test/edge-cases/*.test.ts",
    "test:security": "dotenv -e .env.local -- tsx --test --test-concurrency=1 test/security/*.test.ts",
    "test:performance": "dotenv -e .env.local -- tsx --test --test-concurrency=1 test/performance/*.test.ts",
    "test:watch": "dotenv -e .env.local -- tsx --test --watch --test-concurrency=1 $(find test -name '*.test.ts' | sort)",
    "test:coverage": "node scripts/test-coverage.mjs --threshold 90",
    "test:e2e": "dotenv -e .env.local -- playwright test",
    "migrate:up": "dotenv -e .env.local -- node-pg-migrate up",
    "migrate:deploy": "node-pg-migrate up",
    "migrate:down": "dotenv -e .env.local -- node-pg-migrate down",
    "migrate:create": "node-pg-migrate create"
  },
  "dependencies": {
    "@onevyrt/engine": "workspace:*",
    "@heroicons/react": "^2.2.0",
    "@xyflow/react": "12.10.2",
    "jspdf": "^4.2.1",
    "next": "16.2.12",
    "nodemailer": "^9.0.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "node-pg-migrate": "^9.0.0",
    "postcss": "^8.5.25",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "webpack-bundle-analyzer": "^4.10.1"
  }
}

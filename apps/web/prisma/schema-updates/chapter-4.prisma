// Chapter 4 (IMPROVE & SCALE) — schema specification.
//
// ONEVYRT's live schema is plain PostgreSQL, versioned with node-pg-migrate
// (see apps/web/migrations/*.js) — there is no schema.prisma or @prisma/client
// anywhere in this repo, and this file is never run through `prisma validate`
// or `prisma generate`. It exists as a precise, reviewable specification of
// the Chapter 4 schema in Prisma's schema language, because that language
// says "one column, one type, one constraint" more exactly than prose. Keep
// it in sync with the real migrations it documents.
//
// A note on how the Chapter4Submission model below came to look the way it
// does: docs/IMPLEMENTATION_ROADMAP.md's original sketch for this table was
// normalized — one row per (workspace, subchapter), with dedicated columns
// (constraint_identified, metrics_current, metrics_target, actions[]) for
// each subchapter's output. By the time this spec was written, a concurrent
// lane had already designed, migrated and built a data-access layer around a
// DIFFERENT shape: one row per WORKSPACE, holding the whole evolving plan as
// a single jsonb document — see apps/web/migrations/1787400000000_chapter-4-
// submissions.js (the applied migration) and apps/web/lib/chapter4-
// submissions.ts (the read/write API, with the full reasoning in its header:
// Chapter 4's output is structured data a UI renders directly, not per-
// subchapter free-text evidence, and one mutable document per workspace
// matches how chapter_submissions/enrollments already work in this
// codebase). This file documents that shipped shape rather than a second,
// conflicting design — a chapter_4_submissions table already exists; this is
// its specification, not a proposal to replace it.
//
// Conventions carried over from the rest of this codebase's ~30 migrations
// (see apps/web/migrations/), followed here even though nothing enforces them
// on a .prisma file:
//   - Every id is a plain String, generated by the APPLICATION (node:crypto's
//     randomUUID() or randomBytes(), e.g. apps/web/lib/campaigns.ts,
//     apps/web/lib/chapter4-submissions.ts) before insert — never a database
//     default. No field below carries an @default(uuid()) or similar.
//   - No column is a real Postgres foreign key anywhere in this codebase.
//     workspace_id (below) and chapter_4_submission_id (on Enrollment, below)
//     are plain, unconstrained references the APPLICATION validates on write
//     — the same pattern leads.assignee_id already uses (see
//     apps/web/migrations/1786648000000_lead-assignment.js). Chapter 4 stays
//     consistent with a codebase that has never used a DB-level FK.
//   - Field names below are already the real snake_case column names (not
//     idiomatic Prisma camelCase + @map) so this file is a direct, line-by-
//     line mirror of the actual CREATE TABLE / ALTER TABLE — there is no
//     Prisma Client generated from it for camelCase access to matter.

// One row per WORKSPACE (not per subchapter) — the learner's whole Growth &
// Improvement Plan as it's built up across 4.1-4.6, submitted for review, and
// reviewed by a coach. See apps/web/lib/chapter4-submissions.ts's
// Chapter4PlanData for `data`'s inner shape (currentPosition, bottleneck,
// actions, impact, completedSubchapters) — deliberately Json here rather than
// enumerated as columns, because the API/storage lane that owns this table
// evolves that inner shape independently of this spec.
model Chapter4Submission {
  // Primary key. Every read/write in apps/web/lib/chapter4-submissions.ts
  // keys on this, not `id` below.
  workspace_id String @id

  // A second, stable opaque identifier independent of workspace_id, so an API
  // response (and a future share/PDF surface) has a genuine "submission id"
  // to hand back without exposing workspace_id. Generated once, on first
  // save, never reissued.
  id String

  // "in_progress" | "submitted" | "changes_requested" | "approved" — the
  // whole plan's review state. Compare packages/engine/src/chapter-gates.ts's
  // ChapterReviewStatus ("submitted" | "approved" | "changes_requested"),
  // which this reuses plus "in_progress" for "started but never submitted".
  status String @default("in_progress")

  // The plan itself: current position, named bottleneck, action list, impact
  // inputs, and which subchapters have been saved at least once. See
  // apps/web/lib/chapter4-submissions.ts's Chapter4PlanData.
  data Json @default("{}")

  // Set together when the learner submits for review; both null beforehand.
  submitted_at DateTime?
  submitted_by String?

  // Set together when a coach acts; both null while awaiting review.
  reviewed_at DateTime?
  reviewed_by String?

  // "approved" | "changes_requested", null while unreviewed.
  coach_decision String?
  coach_feedback String?

  updated_at DateTime @default(now())

  // `id` is looked up on its own (see the field's comment above); unique so
  // it's a safe alternate key even though workspace_id is what every real
  // query in this slice actually uses.
  @@unique([id])
  @@map("chapter_4_submissions")
}

// The existing `enrollments` table (apps/web/migrations/1786541862535_create-
// enrollments.js: workspace_id text PK + enrollment jsonb) plus the two
// columns this Chapter 4 slice adds. Shown here in full — not as a diff —
// because a Prisma model describes a table's whole current shape;
// `enrollment` below is the pre-existing column, unchanged by Chapter 4. The
// runnable migration for the two NEW fields is apps/web/migrations/<the
// enrollments-chapter-4-fields migration created alongside this file>.
model Enrollment {
  workspace_id String @id

  // Pre-existing — packages/engine/src/enrollment.ts's Enrollment type,
  // serialized. Untouched by Chapter 4; shown here for a complete model.
  enrollment Json

  // NEW. This workspace's Chapter4Submission.id once that plan reaches
  // "approved" — the one signal that gates progression to Finish, the same
  // role a chapter's `evidence` submission plays for chapters 1-3 in the
  // generic chapter_submissions table. Not a database foreign key (see the
  // file-level note above) — set by the coach-review endpoint once it
  // confirms the referenced chapter_4_submissions row is actually approved.
  chapter_4_submission_id String?

  // NEW. Stamped at the same time as chapter_4_submission_id, once the coach
  // approves — lets Finish-stage gating and the Transformation Report read a
  // plain timestamp column instead of joining chapter_4_submissions (or, once
  // the engine grows a "chapter-4" gate — see packages/engine/src/curriculum-
  // chapters.ts's CURRICULUM_SCHEMA_VERSION 4 — recomputing chapterGates())
  // just to check whether Chapter 4 is done.
  chapter_4_completed_at DateTime?

  @@map("enrollments")
}

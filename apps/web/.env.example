# Database
DATABASE_URL=postgresql://user:password@localhost:5432/onevyrt

# Auth
AUTH_SECRET=your-secret-key-here-32-bytes-or-longer

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=noreply@onevyrt.com

# Twilio (optional)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =================================================================
# ANALYTICS CONFIGURATION (Optional)
# =================================================================

# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Segment
SEGMENT_WRITE_KEY=your_segment_write_key
NEXT_PUBLIC_SEGMENT_WRITE_KEY=your_segment_write_key

# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id

# PostHog (Product Analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Analytics Data Retention (days)
ANALYTICS_DATA_RETENTION_DAYS=90

# Feature Flags
ENABLE_ANALYTICS_DASHBOARD=true
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_TRACKING=true

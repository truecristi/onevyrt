# Database (ov1 uses Supabase as Postgres — session pooler on :5432)
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Database TLS — REQUIRED in production (the app refuses an unverified DB
# connection in prod; see lib/db.ts + startup-checks.ts). Pick ONE:
#   DATABASE_SSL_REJECT_UNAUTHORIZED=1   verify against Node's trust store
#                                        (works when the DB cert chains to a
#                                        public CA — modern Supabase poolers do)
#   DATABASE_CA_CERT_PATH=/certs/db-ca.crt   verify against a bundled CA file
#   DATABASE_CA_CERT="-----BEGIN CERTIFICATE----- …"   inline CA bundle
DATABASE_SSL_REJECT_UNAUTHORIZED=1
# Optional pool tuning (default max 10, suits Supabase session pooler)
# DATABASE_POOL_MAX=10

# Auth — REQUIRED in production (32+ bytes). Never commit the real value.
AUTH_SECRET=your-secret-key-here-32-bytes-or-longer

# Runtime (set by the Docker image for ov1; override here for local runs)
# PORT=8516
# ONEVYRT_ROOT=/data

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=noreply@onevyrt.com

# Twilio (optional)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =================================================================
# ANALYTICS CONFIGURATION (Optional)
# =================================================================

# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Segment
SEGMENT_WRITE_KEY=your_segment_write_key
NEXT_PUBLIC_SEGMENT_WRITE_KEY=your_segment_write_key

# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id

# PostHog (Product Analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Analytics Data Retention (days)
ANALYTICS_DATA_RETENTION_DAYS=90

# Feature Flags
ENABLE_ANALYTICS_DASHBOARD=true
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_TRACKING=true

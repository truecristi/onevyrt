  "React Component: Button Primary": {
    "scope": "typescriptreact,jsx",
    "prefix": ["btn-primary", "button-primary"],
    "body": "<button className=\"btn primary\">${1:Click me}</button>",
    "description": "Primary button using canonical .btn style"
  },
  "React Component: Card": {
    "scope": "typescriptreact,jsx",
    "prefix": ["card", "card-component"],
    "body": "<div className=\"ds-card\">\n  ${1:Content}\n</div>",
    "description": "Standard card with elevation and hover state"
  },
  "React Component: Input": {
    "scope": "typescriptreact,jsx",
    "prefix": ["input-field", "text-input"],
    "body": "<input type=\"${1:text}\" className=\"ds-input\" placeholder=\"${2:Enter text...}\" />",
    "description": "Design system input field"
  },
  "React Component: Badge": {
    "scope": "typescriptreact,jsx",
    "prefix": ["badge", "status-badge"],
    "body": "<span className=\"ds-badge ds-badge--${1|success,warning,danger,info|}\">${2:Status}</span>",
    "description": "Status badge with color variants"
  },
  "React Component: Page Shell": {
    "scope": "typescriptreact,jsx",
    "prefix": ["page-shell", "page-layout"],
    "body": "<div className=\"ds-page\">\n  <div className=\"ds-page__inner\">\n    <div className=\"ds-page__head\">\n      <h1>${1:Page Title}</h1>\n    </div>\n    ${2:Content}\n  </div>\n</div>",
    "description": "Standard page layout with header"
  },
  "CSS: Chapter Color START": {
    "scope": "css",
    "prefix": ["chapter-start", "color-start"],
    "body": "color: var(--ds-chapter-start); background: var(--ds-chapter-start-soft);",
    "description": "START chapter brand colors"
  },
  "CSS: Chapter Color DEFINE": {
    "scope": "css",
    "prefix": ["chapter-define", "color-define"],
    "body": "color: var(--ds-chapter-define); background: var(--ds-chapter-define-soft);",

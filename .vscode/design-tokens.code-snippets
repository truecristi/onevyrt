    "scope": "typescriptreact,typescript",
    "prefix": ["import-tokens", "tokens-import"],
    "body": "import { tokens, searchTokens } from '@/lib/design-tokens';",
    "description": "Import design tokens module"
  },
  "TypeScript: Search Tokens": {
    "scope": "typescriptreact,typescript",
    "prefix": ["search-tokens", "token-search"],
    "body": "const results = searchTokens('${1:brand}');",
    "description": "Search for tokens by pattern"
  }
